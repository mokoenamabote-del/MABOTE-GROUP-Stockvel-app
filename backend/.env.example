# Backend Server Configuration
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret

# Google Sheets Configuration
# Get these values from Google Cloud Console
GOOGLE_SHEETS_ID=your-spreadsheet-id-here
GOOGLE_SHEETS_NAME=Sheet1

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,https://www.mabote-group.co.za,https://mabote-group.co.za

# Gmail password-reset email (use a Google App Password, not your account password)
SMTP_USER=your-sender@gmail.com
SMTP_APP_PASSWORD=your-16-character-app-password
APP_BASE_URL=https://www.mabote-group.co.za

# Set these only when provisioning the default accounts on a new database
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-initial-password
DEFAULT_MANAGEMENT_EMAIL=management@example.com
DEFAULT_MANAGEMENT_PASSWORD=replace-with-a-strong-initial-password
