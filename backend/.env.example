# Backend Server Configuration
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret

# Google Sheets Configuration
# Get these values from Google Cloud Console
GOOGLE_SHEETS_ID=your-spreadsheet-id-here
GOOGLE_SHEETS_NAME=Sheet1

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Password reset email (use an SMTP app password)
SMTP_USER=your-sender@example.com
SMTP_APP_PASSWORD=your-smtp-app-password
SMTP_FROM=your-sender@example.com

# PayFast hosted checkout
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
API_BASE_URL=http://localhost:5000
APP_BASE_URL=http://localhost:5173
