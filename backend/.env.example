# Backend Server Configuration
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret

# Google Sheets Configuration
# Get these values from Google Cloud Console
GOOGLE_SHEETS_ID=your-spreadsheet-id-here
GOOGLE_SHEETS_NAME=Sheet1

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Password reset email (Gmail App Password, not your Gmail sign-in password)
SMTP_USER=your-sender@gmail.com
SMTP_APP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-sender@gmail.com
APP_BASE_URL=http://localhost:5173
